<?xml version="1.0" encoding="UTF-8"?>
<WiFiTool>
    <!-- Quectel FC21 (Realtek RTL8821CU Chipset) -->
    <Module id="quectel_fc21">
        <DisplayName>Quectel FC21 (RTL8821CU)</DisplayName>
        
        <Kernel>
            <KoName>8821cu.ko</KoName>
            <InsmodArgs>rtw_power_mgnt=0 rtw_enusbss=0</InsmodArgs>
            <Interface>wlan0</Interface>
            <DriverBackend>nl80211</DriverBackend>
        </Kernel>

        <StationConfig>
            <Param key="ctrl_interface">/var/run/wpa_supplicant</Param>
            <Param key="update_config">1</Param>
            <Param key="country">CN</Param>
            <Param key="p2p_disabled">1</Param>
        </StationConfig>

        <APConfig>
            <Param key="interface">wlan0</Param>
            <Param key="driver">nl80211</Param>
            <Param key="hw_mode">g</Param>
            <Param key="channel">6</Param>
            <Param key="ieee80211n">1</Param>
            <Param key="wmm_enabled">1</Param>
        </APConfig>
    </Module>

    <!-- Quectel FCM360W (MediaTek MT7663 Chipset) -->
    <Module id="quectel_fcm360w">
        <DisplayName>Quectel FCM360W (MT7663)</DisplayName>
        
        <Kernel>
            <KoName>mt7663u.ko</KoName>
            <InsmodArgs></InsmodArgs>
            <Interface>ra0</Interface>
            <DriverBackend>nl80211</DriverBackend>
        </Kernel>

        <StationConfig>
            <Param key="ctrl_interface">/var/run/wpa_supplicant</Param>
            <Param key="update_config">1</Param>
            <Param key="country">CN</Param>
        </StationConfig>

        <APConfig>
            <Param key="interface">ra0</Param>
            <Param key="driver">nl80211</Param>
            <Param key="hw_mode">g</Param>
            <Param key="channel">6</Param>
            <Param key="ieee80211n">1</Param>
            <Param key="ieee80211ac">1</Param>
        </APConfig>
    </Module>

    <!-- Quectel FCS945R (Realtek RTL8733BS Chipset) -->
    <Module id="quectel_fcs945r">
        <DisplayName>Quectel FCS945R (RTL8733BS)</DisplayName>
        
        <Kernel>
            <KoName>8733bs.ko</KoName>
            <InsmodArgs>rtw_country_code=TW</InsmodArgs>
            <Interface>wlan0</Interface>
            <DriverBackend>nl80211</DriverBackend>
        </Kernel>

        <StationConfig>
            <Param key="ctrl_interface">/var/run/wpa_supplicant</Param>
            <Param key="update_config">1</Param>
        </StationConfig>

        <APConfig>
            <Param key="interface">wlan0</Param>
            <Param key="driver">nl80211</Param>
            <Param key="ctrl_interface">/var/run/hostapd</Param>
            <Param key="ctrl_interface_group">0</Param>
            <Param key="beacon_int">100</Param>
            <Param key="hw_mode">g</Param>
            <Param key="channel">6</Param>
            <Param key="ieee80211n">1</Param>
            <Param key="ht_capab">[HT20][SHORT-GI-20]</Param>
        </APConfig>
    </Module>
</WiFiTool>
