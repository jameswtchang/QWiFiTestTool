<?xml version="1.0" encoding="UTF-8"?>
<WiFiTool>
    <!-- Quectel FCM360W (MediaTek MT7663 Chipset) -->
    <Module id="quectel_fcm360w">
        <DisplayName>Quectel FCM360W (MediaTek MT7663)</DisplayName>
        
        <Kernel>
            <KoName>mt7663u.ko</KoName>
            <InsmodArgs></InsmodArgs>
            <Interface>ra0</Interface>
            <DriverBackend>nl80211</DriverBackend>
        </Kernel>

        <StationConfig>
            <Param key="ctrl_interface">/var/run/wpa_supplicant</Param>
            <Param key="update_config">1</Param>
            <Param key="country">CN</Param>
        </StationConfig>

        <APConfig>
            <Capabilities>
                <Bands>2.4G,5G</Bands>
                <Modes>b,g,n,ac</Modes>
                <MaxBandwidth>80</MaxBandwidth>
                <SupportDFS>false</SupportDFS>
                <SupportWPA3>false</SupportWPA3>
            </Capabilities>

            <APProfile>
                <SSID>FCM360W_AP</SSID>
                <Security>WPA2</Security>
                <Band>2.4G</Band>
                <Channel>6</Channel>
            </APProfile>

            <Network>
                <Gateway>192.168.50.1</Gateway>
                <Netmask>255.255.255.0</Netmask>
                <DHCPStart>192.168.50.100</DHCPStart>
                <DHCPEnd>192.168.50.200</DHCPEnd>
            </Network>

            <FixedParams>
                <Param key="beacon_int">100</Param>
                <Param key="dtim_period">2</Param>
            </FixedParams>

            <Param key="interface">ra0</Param>
            <Param key="driver">nl80211</Param>
            <Param key="hw_mode">g</Param>
            <Param key="channel">6</Param>
            <Param key="ieee80211n">1</Param>
            <Param key="ieee80211ac">1</Param>
        </APConfig>
    </Module>

