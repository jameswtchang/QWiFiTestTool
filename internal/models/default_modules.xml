    <!-- Quectel FGH200M (Morse Micro Chipset) -->
    <Module id="quectel_fgh200m">
        <DisplayName>Quectel FGH200M (Morse Micro MM8108)</DisplayName>
        
        <Kernel>
            <KoName>morse.ko</KoName>
            <PreloadKo>dot11ah.ko</PreloadKo>
            <InsmodArgs>country=US bcf=bcf_default.bin</InsmodArgs>
            <Interface>wlan0</Interface>
            <DriverBackend>nl80211</DriverBackend>
        </Kernel>

        <StationConfig>
            <Param key="ctrl_interface">/var/run/wpa_supplicant_s1g</Param>
            <Param key="pmf">2</Param>
            <Param key="sae_pwe">1</Param>
            <Param key="network_ssid">sdm108a-b9bf</Param>
            <Param key="network_key_mgmt">SAE</Param>
            <Param key="network_sae_password">sdm108a@wifi</Param>
        </StationConfig>

        <APConfig>
            <Capabilities>
                <Bands>sub-GHz</Bands>
                <Modes>ah</Modes>
                <MaxBandwidth>8</MaxBandwidth>
                <SupportDFS>false</SupportDFS>
                <SupportWPA3>true</SupportWPA3>
            </Capabilities>

            <APProfile>
                <SSID>Quectel-halow-200h</SSID>
                <Password>12345678</Password>
                <Security>WPA3</Security>
                <Band>sub-GHz</Band>
                <Channel>40</Channel>
            </APProfile>

            <Network>
                <Gateway>192.168.11.1</Gateway>
                <Netmask>255.255.255.0</Netmask>
                <DHCPStart>192.168.11.2</DHCPStart>
                <DHCPEnd>192.168.11.20</DHCPEnd>
            </Network>

            <FixedParams>
                <Param key="ctrl_interface">/var/run/hostapd_s1g</Param>
                <Param key="country_code">AU</Param>
                <Param key="ieee80211ah">1</Param>
                <Param key="op_class">70</Param>
