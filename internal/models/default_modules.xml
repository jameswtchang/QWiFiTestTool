                <Param key="ap_max_inactivity">65536</Param>
                <Param key="s1g_capab">[SHORT-GI-ALL]</Param>
                <Param key="wnm_sleep_mode">1</Param>
                <Param key="sae_pwe">1</Param>
                <!-- TX queue parameters -->
                <Param key="tx_queue_data3_aifs">7</Param>
                <Param key="tx_queue_data3_cwmin">15</Param>
                <Param key="tx_queue_data3_cwmax">1023</Param>
                <Param key="tx_queue_data3_burst">15.0</Param>
                <Param key="tx_queue_data2_aifs">3</Param>
                <Param key="tx_queue_data2_cwmin">15</Param>
                <Param key="tx_queue_data2_cwmax">1023</Param>
                <Param key="tx_queue_data2_burst">15.0</Param>
                <Param key="tx_queue_data1_aifs">2</Param>
                <Param key="tx_queue_data1_cwmin">7</Param>
                <Param key="tx_queue_data1_cwmax">15</Param>
                <Param key="tx_queue_data1_burst">15.0</Param>
                <Param key="tx_queue_data0_aifs">2</Param>
                <Param key="tx_queue_data0_cwmin">3</Param>
                <Param key="tx_queue_data0_cwmax">7</Param>
                <Param key="tx_queue_data0_burst">15.0</Param>

                <!-- WMM parameters -->
                <Param key="wmm_ac_bk_aifs">7</Param>
                <Param key="wmm_ac_bk_cwmin">4</Param>
                <Param key="wmm_ac_bk_cwmax">10</Param>
                <Param key="wmm_ac_bk_txop_limit">469</Param>
                <Param key="wmm_ac_bk_acm">0</Param>
                <Param key="wmm_ac_be_aifs">3</Param>
                <Param key="wmm_ac_be_cwmin">4</Param>
                <Param key="wmm_ac_be_cwmax">10</Param>
                <Param key="wmm_ac_be_txop_limit">469</Param>
                <Param key="wmm_ac_be_acm">0</Param>
